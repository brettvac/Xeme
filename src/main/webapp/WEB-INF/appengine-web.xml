<?xml version="1.0" encoding="UTF-8"?>

<appengine-web-app xmlns="http://appengine.google.com/ns/1.0">
  
  <runtime>java17</runtime>
  <app-engine-apis>true</app-engine-apis>
  <basic-scaling>
    <max-instances>1</max-instances>
    <idle-timeout>1m</idle-timeout>
  </basic-scaling>
  <version>GCLOUD_CONFIG</version>
  
  <!-- Static Files -->    
  <static-files>
    <include path="index.html" />
    <include path="favicon.ico" />
  </static-files>
  
  <!-- Twitter4j configuration (replace these values with your own—I'm done with Shitter -->    
  <env-variables>
    <env-var name="TWITTER4J_DEBUG" value="true" />
    <env-var name="TWITTER4J_OAUTH_CONSUMER_KEY" value="QU4YR3CNdQsEqIep1v2jBUabE" />
    <env-var name="TWITTER4J_OAUTH_CONSUMER_SECRET" value="WBE907HNeXZAEwKWkxNRlf8CfXa84GOUMbyScqo9lPunPx9sdh" />
    <env-var name="TWITTER4J_OAUTH_ACCESS_TOKEN" value="MY_ACCESS_TOKEN" />
    <env-var name="TWITTER4J_OAUTH_ACCESS_TOKEN_SECRET" value="MY_TOKEN_SECRET" />
  </env-variables>
  
</appengine-web-app>