<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://java.sun.com/xml/ns/javaee" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd" version="2.5">
  
  <servlet>
    <servlet-name>XemeServlet</servlet-name>
    <servlet-class>io.github.brettvac.xeme.XemeServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>XemeServlet</servlet-name>
    <url-pattern>/XemeServlet</url-pattern>
  </servlet-mapping>
  
  <servlet>
    <servlet-name>XemeCronServlet</servlet-name>
    <servlet-class>io.github.brettvac.xeme.XemeCronServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>XemeCronServlet</servlet-name>
    <url-pattern>/cron/XemeCronServlet</url-pattern>
  </servlet-mapping>
    
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>
</web-app>